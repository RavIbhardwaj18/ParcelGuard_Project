{
  "folders": [
    {
      "name": "📦 ParcelGuard (root)",
      "path": "."
    },
    {
      "name": "⚡ Backend (FastAPI)",
      "path": "./backend"
    },
    {
      "name": "🖥️ Frontend (Ops :3000)",
      "path": "./frontend"
    },
    {
      "name": "👤 Customer Portal (:3001)",
      "path": "./customer-portal"
    }
  ],
  "settings": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.tabSize": 2,
    "files.associations": {
      "*.jsx": "javascriptreact",
      "*.env*": "dotenv"
    },
    "python.defaultInterpreterPath": "${workspaceFolder:⚡ Backend (FastAPI)}/venv/bin/python",
    "python.formatting.provider": "black",
    "[python]": {
      "editor.defaultFormatter": "ms-python.black-formatter",
      "editor.formatOnSave": true,
      "editor.tabSize": 4
    },
    "[javascript]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
    "[javascriptreact]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
    "emmet.includeLanguages": { "javascript": "javascriptreact" },
    "css.validate": false,
    "explorer.fileNesting.enabled": true,
    "explorer.fileNesting.patterns": {
      "*.jsx": "${capture}.css, ${capture}.test.jsx",
      "package.json": "package-lock.json, .npmrc, .nvmrc",
      "vite.config.*": ".env, .env.*",
      "*.py": "${capture}.test.py"
    },
    "terminal.integrated.env.linux": {
      "PYTHONPATH": "${workspaceFolder:⚡ Backend (FastAPI)}"
    },
    "terminal.integrated.env.osx": {
      "PYTHONPATH": "${workspaceFolder:⚡ Backend (FastAPI)}"
    }
  },
  "extensions": {
    "recommendations": [
      "ms-python.python",
      "ms-python.black-formatter",
      "charliermarsh.ruff",
      "ms-python.vscode-pylance",
      "esbenp.prettier-vscode",
      "dbaeumer.vscode-eslint",
      "dsznajder.es7-react-js-snippets",
      "bradlc.vscode-tailwindcss",
      "formulahendry.auto-rename-tag",
      "christian-kohler.path-intellisense",
      "PKief.material-icon-theme",
      "mtxr.sqltools",
      "mtxr.sqltools-driver-pg",
      "42crunch.vscode-openapi",
      "humao.rest-client",
      "eamodio.gitlens",
      "usernamehw.errorlens"
    ]
  }
}
