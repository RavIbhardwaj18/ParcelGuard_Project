# ParcelGuard — Backend Environment Variables
# Copy this file to .env and fill in your values
# cp .env.example .env

# ── Database ──────────────────────────────────────────────────────────────────
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql://postgres:password@localhost:5432/parcelguard

# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=development
SECRET_KEY=parcelguard-dev-secret-change-in-production
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=50

# ── AI Model ──────────────────────────────────────────────────────────────────
# ResNet50 weights will be auto-downloaded here on first run (~100MB)
MODEL_CACHE_DIR=./model_cache

# ── Fraud Score Thresholds ────────────────────────────────────────────────────
FRAUD_HIGH_THRESHOLD=70.0
FRAUD_MEDIUM_THRESHOLD=30.0

# ── Fraud Score Weights (must sum to 1.0) ────────────────────────────────────
WEIGHT_IMAGE_DELTA=0.40
WEIGHT_WEIGHT_DELTA=0.25
WEIGHT_RFID_MISMATCH=0.20
WEIGHT_DIM_DELTA=0.15

# ── Trust Score ───────────────────────────────────────────────────────────────
TRUST_INITIAL_SCORE=80.0
TRUST_FRAUD_PENALTY=15.0
TRUST_CLEAN_REWARD=1.5
